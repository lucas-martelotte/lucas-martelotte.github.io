\newcommand\cruleoutline[3][black]{\begingroup
    \fboxsep=0pt\raisebox{\fboxrule}{%
    \fbox{\textcolor{#1}{%
    \rule{\dimexpr #2-2\fboxrule\relax}{\dimexpr #3-2\fboxrule\relax}%
}}}\endgroup}
\newcommand\crule[3][black]{\textcolor{#1}{\rule{#2}{#3}}}

%======== README - DANG ========%
% This package implements the environment "dang" using the tcolorbox package. The environment creates a box contour around whatever is written inside it.
% The code was taken from from https://tex.stackexchange.com/questions/369430/theorems-and-definitions-boxes-numbering-should-be-chapter-wise
%===============================%

\usepackage[most]{tcolorbox}
\tcbset{%
  dang/.style={
    enhanced,
    sharp corners,
    enlarge top by=0.2cm,
    enlarge bottom by=0.2cm,
    before skip=2mm, after skip=2mm,
    colback=white, colframe=black,
    boxrule=0.1mm
    }
}

\tcbset{%
  vdang/.style={
    enhanced,
    sharp corners,
    enlarge top by=0.2cm,
    enlarge bottom by=0.2cm,
    before skip=2mm, after skip=2mm,
    colback=white, colframe=black,
    frame hidden,
    borderline north={0.1mm}{0pt}{black},
    borderline south={0.1mm}{0pt}{black},
    }
}

\newtcolorbox{dang}[1][]{dang,#1}
\newtcolorbox{vdang}[1][]{vdang,#1}


